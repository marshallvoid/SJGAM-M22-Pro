<theme>
	<formatVersion>7</formatVersion>

	<view name="detailed, video">
    		<textlist name="gamelist">
        	<pos>0.01 0.13</pos>
	        <size>0.29 0.86</size>
	        <fontSize>0.045</fontSize>
	        <lineSpacing>1.67</lineSpacing>
	        <horizontalMargin>0.01</horizontalMargin>
          <scrollSound>./_art/sounds/scroll3.wav</scrollSound>
	       </textlist>
	</view>	

 <view name="menu">
    <menuBackground name="menubg">
      <color>202020</color>
    </menuBackground>
	<menuText name="menutext">
	  <fontPath>./_art/Acre.otf</fontPath>
	  <fontSize>.037</fontSize>
	  <color>FFAE00</color>
	</menuText>
	<menuTextEdit name="menutextedit">
      <inactive>./_art/assets/textinput_inactive.png</inactive>
      <active>./_art/assets/textinput_active.png</active>
    </menuTextEdit>
	<menuText name="menufooter">
      <fontSize>.05</fontSize>		 
    </menuText>
  </view>

</theme>
